{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "occupy-x",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROUND_ROBIN", "class_name": "RoundRobin" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoundRobin"] }],
  "routes": [
    { "pattern": "occupy-x.com/*", "zone_name": "occupy-x.com" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
